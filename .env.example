# Kafka broker address (internal Docker network)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Topic names
KAFKA_TOPIC_PAGEVIEWS=pageviews
KAFKA_TOPIC_AGGREGATES=pageview_aggregates

# Kafka broker config
KAFKA_NUM_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# ksqlDB
KSQL_BOOTSTRAP_SERVERS=kafka:29092
KSQL_SERVICE_ID=pageview_pipeline

# Producer throughput (events per second)
PRODUCER_RATE=100

# Raw consumer flush settings (continuous, high-volume stream)
RAW_CONSUMER_FLUSH_INTERVAL_SECS=10
RAW_CONSUMER_FLUSH_BATCH_SIZE=500

# Agg sink flush settings (bursty, ~one record per postcode per 1-min window)
AGG_SINK_FLUSH_INTERVAL_SECS=30
AGG_SINK_FLUSH_BATCH_SIZE=50

# Output paths (inside container)
OUTPUT_RAW_PATH=/app/output/raw
OUTPUT_AGG_PATH=/app/output/agg
