KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_PAGEVIEWS=pageviews
KAFKA_TOPIC_AGGREGATES=pageview_aggregates
KAFKA_NUM_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KSQL_BOOTSTRAP_SERVERS=kafka:29092
KSQL_SERVICE_ID=pageview_pipeline_test
PRODUCER_RATE=10
RAW_CONSUMER_FLUSH_INTERVAL_SECS=5
RAW_CONSUMER_FLUSH_BATCH_SIZE=50
AGG_SINK_FLUSH_INTERVAL_SECS=10
AGG_SINK_FLUSH_BATCH_SIZE=25
OUTPUT_RAW_PATH=/app/output/raw
OUTPUT_AGG_PATH=/app/output/agg
