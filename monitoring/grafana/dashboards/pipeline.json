          "legendFormat": "agg-sink"
        }
      ]
    },
    {
      "title": "Flush Size Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(raw_consumer_flush_size_sum{job=\"raw-consumer\"}[5m]) / rate(raw_consumer_flush_size_count{job=\"raw-consumer\"}[5m])",
